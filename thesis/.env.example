# THESIS — environment
# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------
# The bear runs on Qwen, everything else on Gemini. The claim this supports is
# narrow: it reduces dependence on a single model's reasoning path. It does NOT
# make bull and bear independent — models still share correlated errors.

# Google AI Studio. Speaks OpenAI's wire format at this path, so no separate
# client is needed. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Qwen via Bitget's hackathon gateway (S2 developer handbook, section V).
QWEN_API_KEY=
QWEN_BASE_URL=https://hackathon.bitgetops.com/v1
QWEN_MODEL=qwen3.8-max

# ---------------------------------------------------------------------------
# Quotas — read this before changing the models
# ---------------------------------------------------------------------------
# The binding constraint on the free tier is requests per DAY, not tokens.
# One full THESIS run costs 6 primary-model calls (decomposer, fundamentals,
# market, news, bull, judge), plus repair retries. So:
#
#     20 RPD  ->  ~2-3 runs per day   (unusable for development)
#    500 RPD  ->  ~50 runs per day    (workable)
#
# Hence the split: the five per-run seats go on a Flash Lite tier, and the
# judge — called exactly once per run — goes on the stronger Flash tier, where
# 20 RPD still buys 20 complete runs.
#
# Run `npm run models` to list the exact ids your key can reach; AI Studio's
# API ids do not match the display names in the console.
#
# Pin explicit ids. The `-latest` aliases move to a different underlying model
# without notice, and quota is metered per underlying model — an alias can
# silently relocate your budget. Avoid gemini-3-flash: that bucket was already
# exhausted (43/20 RPD).

GEMINI_VOLUME_MODEL=gemini-3.5-flash-lite
GEMINI_VOLUME_RPM=15
GEMINI_VOLUME_RPD=500

GEMINI_JUDGE_MODEL=gemini-3.8-flash
GEMINI_JUDGE_RPM=5
GEMINI_JUDGE_RPD=20

# 0 disables the check. Qwen's hackathon quota is not published.
QWEN_RPM=0
QWEN_RPD=0

# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------
# 'direct'  Bitget Agent Hub SDK + Yahoo + SEC EDGAR. The default.
# 'signal'  bitget-signal MCP backend — verified serving no live data on
#           2026-09-16. Re-test before enabling.
THESIS_DATA_SOURCE=direct

# SEC requires a descriptive User-Agent with contact details on every request.
# Requests without one get throttled or blocked.
SEC_USER_AGENT=THESIS Research Desk (hackathon) your-email@example.com

# NOTE: api.bitget.com is geo-restricted in some regions. If Bitget calls fail
# with a transport error rather than an API error code, check the network
# before debugging code.
# BITGET_BASE=https://api.bitget.com

# THESIS_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Memory — where theses and their check history live
# ---------------------------------------------------------------------------
# Without these THESIS falls back to an in-memory store. That works locally,
# but on a serverless deploy it means every thesis vanishes on the next cold
# start — and "last checked 18 minutes ago" becomes a number we drew rather
# than a fact we recorded. /api/diag reports persisted:false when unset.
#
# Upstash Redis free tier. Either naming convention is read:
#   - Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN
#   - A direct Upstash install sets UPSTASH_REDIS_REST_URL / ..._TOKEN

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret the recheck cron must present. Without it, anyone could drive
# up model usage and pollute the check log by hitting /api/recheck.
RECHECK_SECRET=
