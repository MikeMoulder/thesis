# THESIS environment
# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------
# The second opinion runs on Qwen, everything else on Gemini. The claim this
# supports is narrow: it reduces dependence on a single model's reasoning path.
# It does NOT make the two independent, because models still share correlated
# errors.
#
# NOTE ON QWEN: qwen3.8-max is a reasoning model, and it will not answer a real
# analytical prompt at all unless hidden thinking is disabled. The request sends
# enable_thinking: false for exactly that reason. Measured: 45s timeout without
# it, about 4s with it. Prove it yourself with:
#     npm run qwen:check -- 3 --compare

# Google AI Studio. Speaks OpenAI's wire format at this path, so no separate
# client is needed. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Qwen via Bitget's hackathon gateway (S2 developer handbook, section V).
QWEN_API_KEY=
QWEN_BASE_URL=https://hackathon.bitgetops.com/v1
QWEN_MODEL=qwen3.8-max

# ---------------------------------------------------------------------------
# Quotas: read this before changing the models
# ---------------------------------------------------------------------------
# The binding constraint on the free tier is requests per DAY, not tokens.
#
# What a run actually costs, measured on production rather than estimated:
#
#     decompose the thesis                    1 call    Gemini
#     write the tripwires                     1 call    Gemini
#     the second opinion                      1 call    Qwen
#     tripwires for anything the second
#       opinion added                         1 call    Gemini, only when
#                                                       it added something
#     --------------------------------------------------------------
#     total                                   4 to 5 calls
#
# A repair retry adds one more when a model returns malformed output.
#
# So 500 RPD buys well over a hundred runs a day, which is why both Gemini
# seats sit on Flash Lite. There is no separate judge tier: an earlier design
# declared fundamentals, market, news, bull and judge seats, none of which
# were ever called, and they have been removed. Three seats exist now, and
# src/llm/index.ts is the list.
#
# Run `npm run models` to list the exact ids your key can reach. AI Studio's
# API ids do not match the display names in the console.
#
# Pin explicit ids. The `-latest` aliases move to a different underlying model
# without notice, and quota is metered per underlying model, so an alias can
# silently relocate your budget. Avoid gemini-3-flash: that bucket was already
# exhausted (43/20 RPD).

GEMINI_VOLUME_MODEL=gemini-3.5-flash-lite
GEMINI_VOLUME_RPM=15
GEMINI_VOLUME_RPD=500

# 0 disables the check. Qwen's hackathon quota is not published.
QWEN_RPM=0
QWEN_RPD=0

# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------
# 'direct'  Bitget Agent Hub SDK + Yahoo + SEC EDGAR. The default.
# 'signal'  bitget-signal MCP backend, verified serving no live data on
#           2026-09-16. Re-test before enabling.
THESIS_DATA_SOURCE=direct

# SEC requires a descriptive User-Agent with contact details on every request.
# Requests without one get throttled or blocked.
SEC_USER_AGENT=THESIS Research Desk (hackathon) your-email@example.com

# NOTE: api.bitget.com is geo-restricted in some regions. If Bitget calls fail
# with a transport error rather than an API error code, check the network
# before debugging code.
# BITGET_BASE=https://api.bitget.com

# THESIS_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Memory: where theses and their check history live
# ---------------------------------------------------------------------------
# Without these THESIS falls back to an in-memory store. That works locally,
# but on a serverless deploy it means every thesis vanishes on the next cold
# start, and "last checked 18 minutes ago" becomes a number we drew rather
# than a fact we recorded. /api/diag reports persisted:false when unset.
#
# Upstash Redis free tier. Either naming convention is read:
#   - Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN
#   - A direct Upstash install sets UPSTASH_REDIS_REST_URL / ..._TOKEN

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret the recheck cron must present. Without it, anyone could drive
# up model usage and pollute the check log by hitting /api/recheck.
RECHECK_SECRET=

# ---------------------------------------------------------------------------
# Telegram: the 24/7 half of the product, delivered
# ---------------------------------------------------------------------------
# The cron re-checks every thesis every 15 minutes. Without this, a tripwire
# that fires at 3am waits until someone opens a browser, and "14 days of
# notice" is notice nobody received.
#
# TG_BOT_TOKEN      from @BotFather: send /newbot and copy what it returns.
# TG_WEBHOOK_SECRET any random string. Telegram presents it on every update
#                   and the webhook rejects anything without it. This is the
#                   ONLY thing separating real traffic from a stranger who
#                   guesses the path and posts a forged bind code. Generate:
#                     node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# The same secret must be set here AND passed to setWebhook, or every update
# is rejected with 401 and the bot looks like it is ignoring everyone.
# Point the bot at a deployment with: npm run tg:webhook -- https://your-app

TG_BOT_TOKEN=
TG_WEBHOOK_SECRET=
